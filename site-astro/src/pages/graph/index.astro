---
// The viewer is a complete, self-contained HTML document generated by
// scripts/graph-viewer/build-site-page.mjs — own <head>, own inline CSS and
// canvas script, payload baked in. It is emitted verbatim here rather than
// living in public/, so that /graph/ resolves in `astro dev` as well as in
// production (the dev server serves public/ by exact path and does not fall
// back to a directory index).
//
// Regenerate with: npm run build && node scripts/graph-viewer/build-site-page.mjs
import raw from '../../graph-page.html?raw';

// Astro emits its own doctype ahead of the template, so drop the generated
// file's — two doctypes render fine but only one of them is real.
const html = raw.replace(/^\s*<!doctype html>\s*/i, '');
---
<Fragment set:html={html} />
