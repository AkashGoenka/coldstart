---
import Head from '../../layouts/Head.astro';
import SvgDefs from '../../components/SvgDefs.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/landing.css';
import '../../styles/backdrop.css';

const title = 'Demo — a visual walkthrough of how coldstart works | coldstart';
const description =
  "Watch the same question run twice on one repo: once by an agent that has to go looking for the file, and once by an agent that starts at the right one because a past session wrote it down.";
// Terminal output lives here, not in the markup: Astro parses `{...}` in the
// template as an expression and `${...}` as interpolation, so real source text
// breaks the build. Frontmatter strings are immune to both.
const readOut = [
  "  14  const SESSION_TTL = 60 * 60 * 24 * 7;",
  "  16  const COOKIE_NAME = 'sid';",
  "  ..",
  "  24  export async function createSession(user: User) {",
  "  29    const token = randomBytes(32).toString('hex');",
  "  31    await redis.set('sess:' + token, JSON.stringify({ uid: user.id }),",
  "  32                    'EX', SESSION_TTL);",
  "  35    return { name: COOKIE_NAME, value: token, httpOnly: true };",
  "  36  }",
];
---
<html lang="en">
<head>
  <Head
    title={title}
    description={description}
    keywords="coldstart demo, coldstart find, coldstart gs, notebook recall, codebase memory demo, AI coding agent navigation"
    canonicalPath="/demo/"
    ogType="website"
    ogTitle="Demo — a visual walkthrough of how coldstart works"
    ogDescription="The first session goes looking. The second starts at the right file. A walkthrough of what coldstart changes inside a real agent session."
    themeColor="#070a11"
  />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
<SvgDefs />
<Nav variant="demo" />

<header class="hero demo-hero">
  <div class="wrap hero-in">
    <h1 class="title">What coldstart changes,<br>inside the session</h1>
    <p class="hero-sub">Below is a walkthrough of one agent answering the same question twice on the same example repo, three days apart. The commands and the output format are the real ones.</p>
  </div>
</header>

<!-- ============================ COLD ============================ -->
<section class="dsec">
  <div class="wrap">
    <div class="dhead">
      <div class="eyebrow">Monday · nobody has written this down</div>
      <h2>It has to go and find out.</h2>
    </div>

    <div class="cc">
      <div class="cc-bar"><span class="cc-file">acme-api</span><span class="cc-badge">Claude Code</span></div>
      <div class="cc-body">

        <div class="turn">
          <div class="g">IN</div>
          <div class="c"><div class="chip">how does authentication work in this codebase?</div></div>
        </div>

        <div class="turn">
          <div class="g"></div>
          <div class="c"><div class="prose think">Nothing written down about auth here. I'll locate the files first.</div></div>
        </div>

        <div class="turn">
          <div class="g">OUT</div>
          <div class="c">
            <div class="tool">
              <div class="th"><span class="dot ok"></span><b>Bash</b> <span class="arg">coldstart find auth session login middleware</span></div>
              <div class="ob"><div>find: auth session login middleware  (4 terms, 112 candidate files)</div><div>&nbsp;</div><div>▸ src/auth/session.ts   [4/4]</div><div>   Role:  defines `session`, `login`; imports `auth`</div><div>   Read:  createSession [L24-58], verifySession [L62-91]</div><div>   Wired: used by `requireAuth.ts`, `login.ts` · near `User.ts`</div><div>   near L31:</div><div>     L29: const token = randomBytes(32).toString('hex');</div><div>     L31: await redis.set('sess:' + token, ..., 'EX', SESSION_TTL);</div><div>&nbsp;</div><div>▸ src/middleware/requireAuth.ts   [3/4]</div><div>   Role:  defines `middleware`, `auth`</div><div>   Wired: uses `session.ts` · used by 14 route files</div><div>&nbsp;</div><div>▸ src/routes/login.ts   [3/4]</div><div>   Role:  defines `login`; imports `session`, `auth`</div><div class="el">… +21 lines</div></div>
            </div>
          </div>
        </div>

        <div class="turn">
          <div class="g">OUT</div>
          <div class="c">
            <div class="tool">
              <div class="th"><span class="dot ok"></span><b>Bash</b> <span class="arg">coldstart gs src/auth/session.ts</span></div>
              <div class="ob"><div>src/auth/session.ts (108 lines, importedBy: 6)</div><div>&nbsp;</div><div>Symbols:</div><div>constant SESSION_TTL [L14]</div><div>constant COOKIE_NAME [L16]</div><div>function createSession  [L24-58]  ← src/routes/login.ts:41</div><div>function verifySession  [L62-91]  ← src/middleware/requireAuth.ts:18</div><div>function destroySession [L95-108] ← src/routes/logout.ts:12</div><div>&nbsp;</div><div>Imports:</div><div>src/db/redis.ts</div><div>src/models/User.ts</div><div>&nbsp;</div><div>Importers (6):</div><div>  Source (4):</div><div>    src/middleware/requireAuth.ts</div><div>    src/routes/login.ts</div><div>    src/routes/logout.ts</div><div>    src/routes/refresh.ts</div><div>  Tests (2):</div><div>    tests/auth.test.ts</div><div>&nbsp;</div><div>Edited together (git history, not a dependency):</div><div>  src/middleware/requireAuth.ts — 14 commits</div><div>  tests/auth.test.ts — 11 commits</div></div>
            </div>
          </div>
        </div>

        <div class="turn">
          <div class="g"></div>
          <div class="c"><div class="prose">Sessions, not JWTs — despite the variable being called <code>token</code>.<br><br><b>Login:</b> <code>src/routes/login.ts:41</code> checks the password, then calls <code>createSession</code>, which writes a random 32-byte token to Redis under <code>sess:&lt;token&gt;</code> with a 7-day TTL and returns it as an httpOnly cookie.<br><br><b>Every protected route:</b> <code>requireAuth</code> pulls that cookie and calls <code>verifySession</code>, which is a single Redis lookup. Nothing is signed and nothing is decoded — if the key is gone from Redis, the session is over.<br><br><b>Logout:</b> <code>destroySession</code> deletes the key. There is no revocation list because there is nothing to revoke.</div></div>
        </div>

        <div class="turn">
          <div class="g"></div>
          <div class="c"><div class="hook"><span class="hl">Stop hook</span> the agent writes this down — the files, the symbols, and the thing that would mislead the next reader — checked against a content hash so it expires when the code moves.</div></div>
        </div>

      </div>
      <div class="cc-in"><span>Reply to Claude…</span><span class="send">↑</span></div>
    </div>
  </div>
</section>

<!-- ============================ WARM ============================ -->
<section class="dsec warm">
  <div class="wrap">
    <div class="dhead">
      <div class="eyebrow">Thursday · a different session, a different person</div>
      <h2>It starts at the right file.</h2>
    </div>

    <div class="cc">
      <div class="cc-bar"><span class="cc-file">acme-api</span><span class="cc-badge">Claude Code</span></div>
      <div class="cc-body">

        <div class="turn">
          <div class="g">IN</div>
          <div class="c"><div class="chip">are we using JWTs for login, or something else?</div></div>
        </div>

        <div class="turn">
          <div class="g"></div>
          <div class="c">
            <div class="note">
              <div class="nh"><span class="nlbl">From the notebook</span><span class="fresh">fresh</span></div>
              <div class="nt">Auth is session cookies in Redis, not JWTs</div>
              <div class="nb2"><code>createSession</code> writes a random 32-byte token to Redis under <code>sess:&lt;token&gt;</code> with a 7-day TTL and returns an httpOnly cookie. <code>requireAuth</code> calls <code>verifySession</code>, a single Redis lookup, on every protected route. Nothing is signed or decoded. The variable is named <code>token</code>, which reads as a JWT and is not one — check Redis before assuming stateless auth.</div>
              <div class="na">src/auth/session.ts · createSession, verifySession</div>
            </div>
          </div>
        </div>

        <p class="cap"><code>fresh</code> = <code>session.ts</code> has not changed a byte since this was written.</p>

        <div class="turn">
          <div class="g"></div>
          <div class="c"><div class="prose think">The note names the file and the two functions. Opening it to confirm before I answer.</div></div>
        </div>

        <div class="turn">
          <div class="g">OUT</div>
          <div class="c">
            <div class="tool">
              <div class="th"><span class="dot ok"></span><b>Read</b> <span class="arg">src/auth/session.ts</span></div>
              <div class="ob">{readOut.map((l) => <div>{l}</div>)}<div class="el">… +72 lines</div></div>
            </div>
          </div>
        </div>

        <div class="turn">
          <div class="g"></div>
          <div class="c"><div class="prose">Confirmed — not JWTs. Session cookies backed by Redis.<br><br>Login stores a random 32-byte token under <code>sess:&lt;token&gt;</code> with a 7-day TTL and sets it as an httpOnly cookie. <code>requireAuth</code> does one Redis lookup per request; nothing is signed or decoded. The <code>token</code> naming is misleading and has caught people out before.<br><br>Practically: sessions can be killed server-side by deleting the key, and auth stops working if Redis is down.</div></div>
        </div>

        <div class="turn">
          <div class="g"></div>
          <div class="c"><div class="tally"><b>One read instead of a search.</b> It still opened the file — it just knew which one, and it inherited the warning about the variable name.</div></div>
        </div>

      </div>
      <div class="cc-in"><span>Reply to Claude…</span><span class="send">↑</span></div>
    </div>

    <div class="dclose">
      <p class="big">Both sessions had the index. Only the second had the note.</p>
      <p class="sm">Neither is free. What changes is how much of the work goes into finding the file rather than answering the question.</p>
      <div class="cta"><a class="btn btn-primary" href="/docs/">Read the docs →</a><a class="btn btn-ghost" href="/docs/notebook/">How the notebook works</a></div>
    </div>
  </div>
</section>

<Footer />
</body>
</html>

<style is:global>
/* ---------- demo page shell ---------- */
.demo-hero{padding:44px 0 8px;}
.demo-hero .title{font-size:clamp(30px,4.6vw,48px);}
.dsec{padding:72px 0;border-top:1px solid var(--line);}
.dsec.warm{border-top-color:var(--line-warm);}
.dhead{max-width:640px;margin:0 auto 36px;text-align:center;}
.dhead h2{margin-top:14px;}
.dhead .lead{margin-top:16px;max-width:500px;margin-inline:auto;}

/* ---------- the Claude Code panel — a replica, on its own neutral ground ---------- */
.cc{max-width:880px;margin:0 auto;background:#1f1f1f;border:1px solid #2f2f2f;border-radius:10px;
  overflow:hidden;text-align:left;box-shadow:0 24px 60px rgba(0,0,0,.42);}
.cc-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;
  padding:11px 16px;background:#252525;border-bottom:1px solid #333;}
.cc-file{font-family:var(--mono);font-size:12px;color:#8a8a8a;}
.cc-badge{font-family:var(--mono);font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;
  color:#8a8a8a;border:1px solid #3a3a3a;border-radius:4px;padding:3px 7px;}
.cc-body{padding:22px 20px 8px;}

.turn{display:grid;grid-template-columns:34px 1fr;gap:14px;align-items:start;margin-bottom:18px;}
.turn > .g{font-family:var(--mono);font-size:10px;letter-spacing:.08em;color:#6e6e6e;
  text-align:right;padding-top:9px;}
.turn > .c{min-width:0;}

.chip{background:#2e2e2e;border-radius:6px;padding:10px 14px;color:#f2f2f2;font-size:13.5px;line-height:1.55;}
.prose{color:#e3e3e3;font-size:13.5px;line-height:1.65;padding:2px 2px;}
.prose.think{color:#9a9a9a;font-style:italic;}
.cc code{font-family:var(--mono);font-size:12.5px;color:#d9a05b;
  background:rgba(255,255,255,.06);border-radius:4px;padding:1px 5px;}

.tool{border:1px solid #383838;border-radius:6px;background:#1a1a1a;overflow:hidden;}
.th{display:flex;align-items:center;gap:8px;padding:9px 12px;border-bottom:1px solid #2c2c2c;
  font-size:13px;color:#f2f2f2;flex-wrap:wrap;}
.th b{font-weight:600;}
.th .arg{font-family:var(--mono);font-size:12px;color:#8a8a8a;}
.dot{width:7px;height:7px;border-radius:50%;flex:none;background:#6b6b6b;}
.dot.ok{background:#7ec89a;}
.ob{padding:11px 12px;font-family:var(--mono);font-size:12px;line-height:1.7;color:#cfcfcf;
  overflow-x:auto;}
.ob > div{white-space:pre;}
.ob .el{color:#6e6e6e;}

/* the note, as the recall hook hands it over */
.note{border:1px solid rgba(239,148,72,.34);border-radius:6px;background:rgba(239,148,72,.05);padding:14px 15px;}
.nh{display:flex;align-items:center;gap:10px;margin-bottom:9px;}
.nlbl{font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#d9a05b;}
.fresh{font-family:var(--mono);font-size:10px;letter-spacing:.06em;color:#7ec89a;
  border:1px solid rgba(126,200,154,.4);border-radius:4px;padding:2px 6px;}
.nt{font-family:var(--display);font-size:17px;color:#f2f2f2;margin-bottom:8px;}
.nb2{font-size:13px;line-height:1.62;color:#cfcfcf;}
.na{margin-top:10px;font-family:var(--mono);font-size:11px;color:#8a8a8a;}

.hook{border-left:2px solid #7ec89a;padding:4px 0 4px 12px;font-size:12.5px;color:#9a9a9a;line-height:1.6;}
.hook .hl{color:#7ec89a;font-family:var(--mono);font-size:11px;letter-spacing:.06em;
  text-transform:uppercase;margin-right:8px;}
.tally{border:1px dashed #3a3a3a;border-radius:6px;padding:11px 13px;font-size:13px;color:#cfcfcf;line-height:1.6;}
.tally b{color:#f2f2f2;font-weight:600;}
.tally em{color:#e3e3e3;font-style:italic;}

.cc-in{display:flex;align-items:center;justify-content:space-between;margin:6px 16px 16px;
  background:#242424;border:1px solid rgba(239,148,72,.45);border-radius:8px;padding:11px 13px;
  font-size:13px;color:#6e6e6e;}
.cc-in .send{width:22px;height:22px;border-radius:5px;background:#a8604a;color:#fff;
  display:grid;place-items:center;font-size:12px;}

/* captions sit outside the replica so the panel carries no marketing copy */
.cap{max-width:600px;margin:-4px auto 20px;padding:0 4px;text-align:center;
  font-size:12.5px;line-height:1.6;color:var(--faint);}
.cap code{font-family:var(--mono);font-size:11.5px;color:var(--ember);background:none;padding:0;}

/* The hero sub is the page's only framing line - it says the repo is an
   example, so a reader does not take the terminal for captured output. */
.demo-hero .hero-sub{max-width:600px;margin-inline:auto;}

.dclose{max-width:660px;margin:56px auto 0;text-align:center;}
.dclose .big{font-family:var(--display);font-size:clamp(20px,2.6vw,26px);color:var(--text);line-height:1.35;}
.dclose .sm{margin-top:12px;font-size:15px;color:var(--muted);line-height:1.6;}
.dclose .cta{margin-top:28px;justify-content:center;}

@media(max-width:720px){
  .cc-body{padding:18px 12px 6px;}
  .turn{grid-template-columns:22px 1fr;gap:9px;}
  .turn > .g{font-size:9px;}
  .ob{font-size:11px;}
}
</style>
