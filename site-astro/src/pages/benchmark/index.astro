const title = 'How I benchmark codebase memory, and how you can | coldstart';
const description =
  'The method behind my numbers: questions taken from issue reports, right answers taken from the commits that closed them, and the training-data problem that made me throw my first benchmark away. Run it on any skill, rules file, or tool.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'How I benchmark codebase memory, and how you can',
  description,
  url: 'https://coldstartmcp.dev/benchmark/',
  author: { '@type': 'Person', name: 'Akash Goenka' },
  publisher: { '@type': 'Organization', name: 'coldstart' },
  about: 'Benchmarking AI coding agent tools',
  proficiencyLevel: 'Beginner',
};
---
<html lang="en">
<head>
  <Head
    title={title}
    description={description}
    keywords="benchmark AI coding agent, token usage benchmark, codebase memory, measuring agent tools, training data contamination, benchmark methodology, agent token savings"
    canonicalPath="/benchmark/"
    ogType="article"
    ogTitle="How I benchmark codebase memory, and how you can"
