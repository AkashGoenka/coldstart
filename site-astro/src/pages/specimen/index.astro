<!-- ============ DEV CONTROL — specimen only, never ships ============ -->
<div id="fieldctl">
  <button id="ctl-toggle" type="button" aria-expanded="true">field</button>
  <div id="ctl-body">
    <label>shape
      <select id="c-shape">
        <option value="glow">corner glow (current)</option>
        <option value="edge">edge bleed</option>
        <option value="ramp" selected>flat ramp</option>
        <option value="off">off</option>
      </select>
    </label>
    <label>frost <input id="c-fa" type="range" min="0" max="60" value="20"><output id="o-fa">.20</output></label>
    <label>ember <input id="c-ea" type="range" min="0" max="60" value="19"><output id="o-ea">.19</output></label>
    <label>spread <input id="c-sp" type="range" min="4" max="95" value="50"><output id="o-sp">50%</output></label>
    <pre id="ctl-out"></pre>
  </div>
</div>
<style>
#fieldctl{position:fixed;right:16px;bottom:16px;z-index:99;width:250px;
  background:rgba(14,18,26,.94);border:1px solid rgba(255,255,255,.14);border-radius:10px;
  font-family:var(--mono);font-size:11px;color:#cfd8e6;backdrop-filter:blur(10px);}
#ctl-toggle{width:100%;text-align:left;background:none;border:0;color:#7f8da2;cursor:pointer;
  font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;padding:9px 12px;}
#ctl-body{padding:0 12px 12px;display:grid;gap:9px;}
#fieldctl.closed #ctl-body{display:none;}
#fieldctl label{display:grid;grid-template-columns:44px 1fr 38px;align-items:center;gap:8px;color:#7f8da2;}
#fieldctl select{grid-column:2 / span 2;background:#131a26;color:#cfd8e6;border:1px solid rgba(255,255,255,.14);
  border-radius:5px;padding:4px 6px;font-family:var(--mono);font-size:11px;}
#fieldctl input[type=range]{width:100%;accent-color:#4fbfe0;}
#fieldctl output{text-align:right;color:#cfd8e6;}
#ctl-out{margin:2px 0 0;padding:8px;background:#0a0f18;border:1px solid rgba(255,255,255,.09);
  border-radius:6px;font-size:10px;line-height:1.5;color:#8fb9c9;white-space:pre-wrap;word-break:break-all;}
@media(max-width:860px){#fieldctl{display:none;}}
</style>
<script>
(function(){
  var r=document.documentElement, W=document.getElementById('fieldctl');
  var sh=document.getElementById('c-shape'), fa=document.getElementById('c-fa'),
      ea=document.getElementById('c-ea'), sp=document.getElementById('c-sp'),
      out=document.getElementById('ctl-out');
  var DEFAULT_SPREAD={glow:78,edge:16,ramp:50,off:50};
  function apply(){
    r.dataset.shape=sh.value;
    r.style.setProperty('--fa',(fa.value/100).toFixed(2));
    r.style.setProperty('--ea',(ea.value/100).toFixed(2));
    r.style.setProperty('--sp',sp.value);
    document.getElementById('o-fa').value='.'+String(fa.value).padStart(2,'0');
    document.getElementById('o-ea').value='.'+String(ea.value).padStart(2,'0');
    document.getElementById('o-sp').value=sp.value+'%';
    out.textContent='shape: '+sh.value+'\n--fa: '+(fa.value/100).toFixed(2)
      +'\n--ea: '+(ea.value/100).toFixed(2)+'\n--sp: '+sp.value;
  }
  sh.addEventListener('change',function(){ sp.value=DEFAULT_SPREAD[sh.value]; apply(); });
  [fa,ea,sp].forEach(function(el){ el.addEventListener('input',apply); });
  document.getElementById('ctl-toggle').addEventListener('click',function(){
    W.classList.toggle('closed');
    this.setAttribute('aria-expanded', String(!W.classList.contains('closed')));
  });
  apply();
})();
</script>
</body>
</html>
