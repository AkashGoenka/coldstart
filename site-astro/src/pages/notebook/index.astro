---
// The viewer is a complete, self-contained HTML document generated by
// scripts/kb-viewer/build-site-page.mjs — own <head>, own inline CSS and
// script, this repo's real notebook baked in. Same pattern as /graph/
// (site-astro/src/pages/graph/index.astro) and for the same reason: it is
// emitted verbatim here rather than living in public/, so that /notebook/
// resolves in `astro dev` as well as in production.
//
// Regenerate with: npm run build && node scripts/kb-viewer/build-site-page.mjs
import raw from '../../notebook-page.html?raw';

// Astro emits its own doctype ahead of the template, so drop the generated
// file's — two doctypes render fine but only one of them is real.
const html = raw.replace(/^\s*<!doctype html>\s*/i, '');

// The kb-view template has no <meta charset>: it's designed to be opened as a
// local file, where browsers default to UTF-8. Served over HTTP without one,
// the note text (em dashes, etc.) gets mis-decoded as Latin-1. Site-only fix —
// the generated template itself is correct for its actual (local-file) use.
---
<meta charset="utf-8" />
<Fragment set:html={html} />
